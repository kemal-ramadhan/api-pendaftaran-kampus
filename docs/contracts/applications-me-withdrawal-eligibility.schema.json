{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WithdrawalEligibilityResponse",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "allowed": { "type": "boolean" },
        "requires_approval": { "type": "boolean" },
        "block_reason_label": { "type": "string" },
        "consequences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason_categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "label": { "type": "string" }
            },
            "required": ["code", "label"]
          }
        }
      },
      "required": ["allowed", "requires_approval", "consequences", "reason_categories"]
    }
  },
  "required": ["success", "message", "data"]
}
