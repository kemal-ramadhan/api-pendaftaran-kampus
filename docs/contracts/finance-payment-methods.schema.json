{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentMethodsResponse",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paymentMethod": { "type": "string" },
          "paymentName": { "type": "string" },
          "paymentImage": { "type": "string" },
          "totalFee": { "type": "string" }
        },
        "required": ["paymentMethod", "paymentName", "paymentImage", "totalFee"]
      }
    }
  },
  "required": ["success", "message", "data"]
}
