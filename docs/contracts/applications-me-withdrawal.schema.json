{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WithdrawalDetailResponse",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "application_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "stage_at_request": { "type": "string" },
        "reason_category": { "type": "string" },
        "reason_text": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled", "effective"] },
        "requires_approval": { "type": "boolean" },
        "letter_number": { "type": "string" },
        "requested_at": { "type": "string", "format": "date-time" },
        "effective_at": { "type": ["string", "null"] }
      },
      "required": ["id", "application_id", "user_id", "status", "reason_category", "reason_text", "requested_at"]
    }
  },
  "required": ["success", "message", "data"]
}
