APP_NAME="PMB Template Service"
APP_ENV=development
APP_PORT=8081

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=pmb_user
DB_PASSWORD=pmb_password
DB_NAME=pmb_template

# Security & Gateway
GATEWAY_SHARED_SECRET=secret-gateway-hmac
INTERNAL_TOKEN=secret-internal-token

# MinIO / Object Storage (jika service membutuhkan penyimpanan berkas)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
