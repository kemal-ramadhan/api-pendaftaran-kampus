APP_NAME="PMB Universitas"
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:5173
DB_HOST=db_auth
DB_PORT=5432
DB_USER=pmb_user
DB_PASSWORD=pmb_password
DB_NAME=pmb_auth
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_KID=pmb-auth-1
JWT_ISSUER=pmb-auth-service
JWT_AUDIENCE=pmb-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
OTP_TTL=10m
OTP_SECRET=change-this-otp-secret-key-32bytes-min
INTERNAL_TOKEN=change-this-internal-token-secret
GATEWAY_SHARED_SECRET=change-this-gateway-shared-secret
MAIL_DRIVER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=pmb@kampus.ac.id
MAIL_FROM_NAME="PMB Universitas"
SEED_SUPERADMIN_EMAIL=superadmin@kampus.ac.id
SEED_SUPERADMIN_PASSWORD=Superadmin123!
GOOGLE_LOGIN_ENABLED=false
RATE_LIMIT_ENABLED=true
OTEL_EXPORTER_ENDPOINT=
