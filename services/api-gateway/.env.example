APP_ENV=development
APP_PORT=8000
ROUTES_CONFIG=./config/routes.yaml
AUTH_SERVICE_URL=http://auth-service:8080
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
JWT_ISSUER=pmb-auth-service
JWT_AUDIENCE=pmb-api
REDIS_ADDR=redis:6379
GATEWAY_SHARED_SECRET=change-this-gateway-shared-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_GLOBAL=120/1m
TRUSTED_PROXIES=
OTEL_EXPORTER_ENDPOINT=
