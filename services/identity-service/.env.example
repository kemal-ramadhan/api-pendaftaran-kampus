APP_NAME=identity-service
APP_ENV=development
APP_PORT=8082

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=pmb_user
DB_PASSWORD=pmb_password
DB_NAME=pmb_identity

# Kriptografi NIK (32-byte key hex untuk AES-256 GCM)
IDENTITY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Keamanan & Gateway
GATEWAY_SHARED_SECRET=secret-gateway-hmac
INTERNAL_TOKEN=secret-internal-token

# MinIO Storage S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=

# Layanan OCR Internal
OCR_SERVICE_URL=http://localhost:8088

# Redis
REDIS_ADDR=localhost:6379
