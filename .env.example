# PMB Backend - Root Environment Configuration Template (.env.example)

# Lingkungan Aplikasi
APP_ENV=development
GATEWAY_PORT=8000
GATEWAY_SHARED_SECRET=your-gateway-shared-secret-key-min-32-chars
INTERNAL_TOKEN=your-internal-service-token-min-32-chars

# JWT Authentication
JWT_ACCESS_SECRET=your-access-token-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-key-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Basis Data PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=pmb_user
DB_PASSWORD=pmb_password
DB_NAME=pmb_auth

# Cache & Sesi Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pmb_redis_secret

# Gateway Pembayaran Duitku
PAYMENT_PROVIDER=duitku
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=your-duitku-api-key
DUITKU_EXPIRY_MINUTES=1440
DUITKU_CALLBACK_URL=http://localhost:8000/api/v1/finance/webhooks/payments/duitku
DUITKU_RETURN_URL=http://localhost:3000/dashboard/pembayaran/status
ALLOW_SANDBOX_IN_PRODUCTION=false
RECONCILIATION_INTERVAL_MINUTES=10

# Object Storage MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Pengiriman Email SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pmb.kampus.ac.id
